# Salin ke .env lalu isi seperlunya. Jangan commit .env.
# Seluruh data JKN-Sentinel adalah data tiruan.

# --- PostgreSQL (dipakai docker-compose untuk membuat database) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

# --- Backend ---
# Di dalam docker-compose host database adalah "db".
# Untuk menjalankan backend di luar Docker, ganti "db" dengan "localhost".
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@db:5432/sentinel

# Kunci API Anthropic untuk agen perangkum (fase 6). Kosongkan untuk mode tanpa AI.
ANTHROPIC_API_KEY=
# CATATAN: ID model perlu dicek ulang di dokumentasi resmi Anthropic
# (https://docs.anthropic.com/en/docs/about-claude/models) sebelum fase 6.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Frontend ---
# Alamat backend yang dipanggil server Next.js untuk mengecek /health.
# Di docker-compose: http://backend:8000 (nama layanan di jaringan Docker).
# Jika frontend dijalankan di luar Docker (npm run dev), pakai http://localhost:8000;
# itu juga nilai default di kode jika variabel ini tidak diset.
BACKEND_URL=http://backend:8000

# true = aktifkan panel demo (misalnya "Sisipkan kecurangan", fase 5).
DEMO_MODE=false

# Opsional: lokasi file parameter. Default: config/parameter.yaml di root repo.
# PARAMETER_PATH=
